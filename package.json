{
  "name": "javis",
  "version": "0.2.0",
  "private": true,
  "description": "FirstMate — 文件优先、模型可插拔、知识可版本化的本地 Agent 工作台。",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "pnpm --filter electron build && electron electron/",
    "start": "pnpm --filter electron start",
    "build": "pnpm --filter renderer build && pnpm --filter electron build",
    "typecheck": "pnpm -r typecheck"
  },
  "workspaces": [
    "electron",
    "renderer"
  ],
  "packageManager": "pnpm@10.9.7"
}
